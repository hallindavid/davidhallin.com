{
  "name": "davidhallin",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "packageManager": "npm@11.11.0",
  "scripts": {
    "build": "postcss ./resources/styles/style.css -o ./static/css/style.css",
    "check": "npm run prod && hugo --gc --minify --destination /tmp/davidhallin-hugo-check --cacheDir /tmp/davidhallin-hugo-cache --panicOnWarning --printPathWarnings --printUnusedTemplates",
    "prod": "NODE_ENV=production postcss ./resources/styles/style.css -o ./static/css/style.css",
    "deploy": "npm run prod && hugo --gc --minify",
    "format": "prettier --write \"layouts/**/*.{html,json}\" \"resources/**/*.{css,js,json,yml,yaml}\" \"static/js/**/*.js\" \"data/**/*.{json,yml,yaml}\" \"*.{json,js,css,yml,yaml}\"",
    "format:check": "prettier --check \"layouts/**/*.{html,json}\" \"resources/**/*.{css,js,json,yml,yaml}\" \"static/js/**/*.js\" \"data/**/*.{json,yml,yaml}\" \"*.{json,js,css,yml,yaml}\"",
    "format:content": "prettier --write \"content/**/*.md\" \"archetypes/**/*.md\" \"README.md\"",
    "format:content:check": "prettier --check \"content/**/*.md\" \"archetypes/**/*.md\" \"README.md\"",
    "lint": "npm run format:check && npm run check",
    "watch": "npm run build && hugo server -D"
  },
  "keywords": [],
  "author": "David Hallin",
  "license": "ISC",
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/postcss": "^4.3.0",
    "postcss": "^8.5.14",
    "postcss-cli": "^11.0.1",
    "prettier": "^3.8.3",
    "prettier-plugin-go-template": "^0.0.15",
    "tailwindcss": "^4.3.0"
  }
}
